# =====================================================================
# MyApiTools 同步服务 —— 生产 nginx 反代配置（示例）
#
# 用法：
#   1. 把 <DOMAIN> 换成你的域名，把证书路径换成真实路径
#   2. 放到 /etc/nginx/conf.d/myapitools.conf（或 sites-available）
#   3. nginx -t && systemctl reload nginx
#   4. 客户端「设置 → 同步」服务地址填 https://<DOMAIN>（不带端口、不带 /api）
#
# 前置：容器已在 127.0.0.1:8787 跑起来（docker compose up -d）。
# 本配置默认只转发业务（/api/*）与客户端更新；管理端入口见文件末尾注释。
# =====================================================================

# ---- 可选：HTTP 强制跳 HTTPS ----
server {
    listen 80;
    server_name <DOMAIN>;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name <DOMAIN>;

    # ---- 证书（用你自己的，如 certbot / 云厂商证书）----
    ssl_certificate     /etc/nginx/certs/<DOMAIN>/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/<DOMAIN>/privkey.pem;

    # ---- 关键：客户端要上传/下载 70~120MB 的安装包，默认 1m 会被挡 ----
    client_max_body_size 600m;

    # 大文件上传下载慢，别被默认 60s 掐断
    proxy_read_timeout  300s;
    proxy_send_timeout  300s;

    # =================================================================
    # 管理端入口（/admin 与 /api/admin/*）—— 默认【必须拦截】，绝不上公网
    #
    # ⚠️ 安全要点：本服务管理端的「来源限制」锁按 TCP 连接来源 IP 判断
    #    （server.js 的 clientIp() 取 req.socket.remoteAddress，不信任
    #    X-Forwarded-For）。nginx 与容器同机、连 127.0.0.1:8787，于是经过
    #    nginx 的公网请求在服务端看来都来自「本机回环」，来源白名单锁会被绕过。
    #    所以公网 nginx 必须在这里显式拦掉管理端，让它根本到不了后端：
    # =================================================================
    location ^~ /admin      { return 404; }
    location ^~ /api/admin/ { return 404; }

    # ---- 业务接口 / 客户端更新 / 静态资源，全部转给容器 ----
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # =================================================================
    # （可选）方案 B：想让管理端也经 nginx 暴露 —— 不推荐，仅图方便时启用。
    #   把上面两行 return 404 注释掉、放开下面这段，并加 basic auth + IP 白名单
    #   做纵深防御（应用本身仍有令牌校验）。注意：来源锁已因回环被绕过，
    #   故 basic auth + allow/deny 是此时唯一的公网防护，务必配。
    # =================================================================
    #
    # location ^~ /admin {
    #     allow  <你的固定IP>;     # 仅允许办公出口 IP；不要白名单就删这两行
    #     deny   all;
    #     auth_basic           "MyApiTools Admin";
    #     auth_basic_user_file /etc/nginx/.htpasswd_myapitools;  # htpasswd -c 生成
    #     proxy_pass http://127.0.0.1:8787;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    # }
}
