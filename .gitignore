# 依赖与构建产物
node_modules/
dist/
build/

# 同步服务运行数据（含账号与配置，绝不入库）
server/data/
*.db
*.db-shm
*.db-wal
*.db-journal

# 管理端令牌：拿到它就能管理全部账号，任何情况下都不能提交
admin-token.txt
*.admin-token.txt

# 客户端安装包：默认落在 server/data/releases/（已被上面挡住），
# 这里再挡一下把 RELEASES_DIR 指到 server/ 下的场景 —— 几百 MB 的包不该进仓库
server/releases/

# 本地工作区备份 / 损坏留档
workspace.json
workspace.backup.json
workspace.json.corrupt-*

# AI 工具的本地工作区/记忆
.workbuddy/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
